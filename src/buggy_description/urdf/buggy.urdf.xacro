<?xml version="1.0"?>

<robot name="buggy" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============================= -->
    <!-- Vehicle dimensions            -->
    <!-- ============================= -->

    <xacro:property name="wheelbase" value="2.5"/>
    <xacro:property name="track_width" value="1.7"/>
    <xacro:property name="wheel_radius" value="0.30"/>
    <xacro:property name="wheel_width" value="0.20"/>

    <xacro:property name="chassis_length" value="3.2"/>
    <xacro:property name="chassis_width" value="1.4"/>
    <xacro:property name="chassis_height" value="0.35"/>

    <xacro:property name="front_x" value="${wheelbase / 2}"/>
    <xacro:property name="rear_x" value="${-wheelbase / 2}"/>
    <xacro:property name="wheel_y" value="${track_width / 2}"/>

    <!-- ============================= -->
    <!-- Main chassis                  -->
    <!-- ============================= -->

    <link name="base_link">

        <visual>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>

            <material name="chassis_material">
                <color rgba="0.15 0.25 0.35 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="100.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <inertia
    ixx="17.354"
    ixy="0.0"
    ixz="0.0"
    iyy="86.354"
    iyz="0.0"
    izz="101.667"/>
        </inertial>

    </link>


    <!-- ============================= -->
    <!-- Reusable wheel definition     -->
    <!-- ============================= -->

        <!-- ================================= -->
    <!-- Front steering knuckles           -->
    <!-- ================================= -->

    <xacro:macro name="steering_knuckle" params="name x y">

        <link name="${name}">
            <inertial>
                <mass value="1.0"/>
                <inertia
                    ixx="0.01"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.01"
                    iyz="0.0"
                    izz="0.01"/>
            </inertial>
        </link>

        <joint name="${name}_joint" type="revolute">
            <parent link="base_link"/>
            <child link="${name}"/>

            <origin
                xyz="${x} ${y} ${-(chassis_height/2 + wheel_radius)}"
                rpy="0 0 0"/>

            <axis xyz="0 0 1"/>

            <limit
                lower="-0.55"
                upper="0.55"
                effort="100"
                velocity="1.5"/>

            <dynamics damping="0.1" friction="0.0"/>
        </joint>

    </xacro:macro>


    <!-- ================================= -->
    <!-- Reusable wheel                    -->
    <!-- ================================= -->

    <xacro:macro name="wheel" params="name parent x y z">

        <link name="${name}">

            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>

                <material name="tire_material">
                    <color rgba="0.08 0.08 0.08 1"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>
            </collision>

            <inertial>
                <mass value="8.0"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <inertia
                    ixx="0.2067"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="0.36"
                    iyz="0.0"
                    izz="0.2067"/>
            </inertial>

        </link>

        <joint name="${name}_joint" type="continuous">

            <parent link="${parent}"/>
            <child link="${name}"/>

            <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>

            <axis xyz="0 1 0"/>

        </joint>

    </xacro:macro>


    <!-- ================================= -->
    <!-- Instantiate front steering links  -->
    <!-- ================================= -->

    <xacro:steering_knuckle
        name="front_left_steering"
        x="${front_x}"
        y="${wheel_y}"/>

    <xacro:steering_knuckle
        name="front_right_steering"
        x="${front_x}"
        y="${-wheel_y}"/>


    <!-- ================================= -->
    <!-- Front wheels                      -->
    <!-- ================================= -->

    <xacro:wheel
        name="front_left_wheel"
        parent="front_left_steering"
        x="0" y="0" z="0"/>

    <xacro:wheel
        name="front_right_wheel"
        parent="front_right_steering"
        x="0" y="0" z="0"/>


    <!-- ================================= -->
    <!-- Rear wheels                       -->
    <!-- ================================= -->

    <xacro:wheel
        name="rear_left_wheel"
        parent="base_link"
        x="${rear_x}"
        y="${wheel_y}"
        z="${-(chassis_height/2 + wheel_radius)}"/>

    <xacro:wheel
        name="rear_right_wheel"
        parent="base_link"
        x="${rear_x}"
        y="${-wheel_y}"
        z="${-(chassis_height/2 + wheel_radius)}"/>

</robot>

    <!-- ============================= -->
    <!-- Four wheels                   -->
    <!-- ============================= -->

    <xacro:wheel
        name="front_left_wheel"
        x="${front_x}"
        y="${wheel_y}"/>

    <xacro:wheel
        name="front_right_wheel"
        x="${front_x}"
        y="${-wheel_y}"/>

    <xacro:wheel
        name="rear_left_wheel"
        x="${rear_x}"
        y="${wheel_y}"/>

    <xacro:wheel
        name="rear_right_wheel"
        x="${rear_x}"
        y="${-wheel_y}"/>

</robot>
